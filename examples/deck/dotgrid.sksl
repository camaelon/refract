// Title / section backdrop: a grid of dots lit by a soft glow that slowly drifts around,
// so different parts of the grid brighten over time. Deep navy base, blue-white dots.
uniform float2 iResolution;
uniform float iTime;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float aspect = iResolution.x / iResolution.y;

    // Base: deep navy with a gentle diagonal gradient.
    float3 col = mix(float3(0.015, 0.025, 0.05),
                     float3(0.04, 0.06, 0.12), uv.x * 0.55 + uv.y * 0.45);

    // Square dot grid (cell size relative to height so cells stay square).
    float cells = 26.0;
    float2 g = fragCoord / (iResolution.y / cells);
    float2 f = fract(g) - 0.5;
    float dg = smoothstep(0.17, 0.09, length(f));      // the dot mask

    // A soft light that orbits; dots near it glow blue-white.
    float t = iTime * 0.28;
    float2 light = float2(0.5 + 0.42 * cos(t), 0.44 + 0.32 * sin(t * 1.3));
    float2 p  = float2(uv.x * aspect, uv.y);
    float2 lp = float2(light.x * aspect, light.y);
    float glow = smoothstep(1.0, 0.0, length(p - lp));
    glow *= glow;                                       // tighten the falloff

    // Dots: very dim baseline, bright near the light.
    col += dg * (0.05 + 0.85 * glow) * float3(0.55, 0.72, 1.0);
    // A faint ambient wash from the light itself.
    col += glow * 0.06 * float3(0.30, 0.50, 1.00);

    // Vignette so the edges settle.
    float2 c = uv - 0.5;
    col *= 1.0 - dot(c, c) * 0.5;

    return half4(col, 1.0);
}
