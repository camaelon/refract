// Title-element backdrop: a dot grid that composites *on top of* the slide background
// (transparent between dots). A soft column of brighter dots sweeps left → right → back,
// and the band fades toward its edges so it blends rather than looking clipped.
// Output is premultiplied alpha.
uniform float2 iResolution;
uniform float iTime;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;

    // Dot grid at a fixed pixel spacing → consistent, small title-appropriate dots.
    float cellPx = 30.0;
    float2 f = fract(fragCoord / cellPx) - 0.5;
    float dg = smoothstep(0.13, 0.065, length(f));        // the dot mask (small dots)

    // A bright column of dots that sweeps left → right → back, with a couple of smaller
    // out-of-phase wobbles at incommensurate rates so the motion feels irregular rather
    // than a plain metronome. Starts near the left at t=0.
    float t = iTime;
    float lx = 0.5
             - 0.36 * cos(t * 0.34)
             + 0.06 * sin(t * 0.83 + 1.3)
             + 0.035 * sin(t * 1.47 + 4.1);
    float w = 0.30 + 0.05 * sin(t * 0.61 + 2.0);          // width breathes a little too
    float glow = smoothstep(w, 0.0, abs(uv.x - lx));
    glow *= glow;

    // Fade toward the band edges (top/bottom, and gently left/right) so it attenuates
    // instead of clipping.
    float fx = smoothstep(0.0, 0.06, uv.x) * smoothstep(1.0, 0.94, uv.x);
    float fy = smoothstep(0.0, 0.30, uv.y) * smoothstep(1.0, 0.70, uv.y);
    float fade = fx * fy;

    // Dimmer so the title stays readable: low baseline, gentler glow.
    float a = dg * (0.05 + 0.55 * glow) * fade;
    return half4(float3(0.60, 0.76, 1.00) * a, a);        // premultiplied
}
