// Transition overlay: a few light dots rise from the bottom and fade out quickly.
// Drawn on top of the slide only while a transition plays. `iProgress` is the
// transition's 0→1 progress; the effect is enveloped to nothing at 0 and 1 so it
// lives purely during the move. Output is premultiplied for SrcOver compositing.
uniform float2 iResolution;
uniform float iTime;
uniform float iProgress;      // 0 → 1 across the transition

float hash(float n) { return fract(sin(n) * 43758.5453); }

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float aspect = iResolution.x / iResolution.y;
    float2 p = float2(uv.x * aspect, uv.y);

    // Live only during the transition: fade in fast, fade out before it ends.
    float env = smoothstep(0.0, 0.12, iProgress) * smoothstep(1.0, 0.75, iProgress);

    float3 col = float3(0.0);
    float alpha = 0.0;

    const int N = 16;
    for (int i = 0; i < N; i++) {
        float fi = float(i);
        float x = hash(fi * 3.3);                       // horizontal lane
        float speed = 0.8 + hash(fi * 5.1) * 0.7;
        float life = fract(iProgress * speed + hash(fi * 1.7));   // 0→1 per dot
        float y = 1.05 - life * 1.15;                   // rise from just below the bottom

        float2 c = float2(x * aspect, y);
        float r = 0.005 + hash(fi * 7.7) * 0.010;       // small circle
        float dot = smoothstep(r, 0.0, length(p - c));

        // Bright when young, gone by the end of its life (fades out quickly).
        float fade = smoothstep(0.0, 0.12, life) * smoothstep(1.0, 0.5, life);
        float a = dot * fade;

        float3 tint = float3(0.75, 0.88, 1.0) + 0.1 * sin(fi + iTime);
        col += tint * a;
        alpha += a;
    }

    col *= env;
    alpha = clamp(alpha, 0.0, 1.0) * env * 0.85;
    return half4(col, alpha);                           // premultiplied
}
