// Peaceful but visible slide background: slow flowing waves in a calm palette.
uniform float2 iResolution;
uniform float iTime;

half4 main(float2 fragCoord) {
    float2 uv = fragCoord / iResolution;
    float t = iTime * 0.12;              // slow

    float x = uv.x;
    float y = uv.y;

    // Smoothly undulating field (0..1) from three drifting wave layers.
    float f = 0.0;
    f += 0.5 + 0.5 * sin(x * 4.0 + y * 1.5 + t * 1.3);
    f += 0.5 + 0.5 * sin(x * 2.0 - y * 3.0 - t * 0.9);
    f += 0.5 + 0.5 * sin((x + y) * 3.0 + t * 0.7);
    f /= 3.0;

    // Calm palette: deep navy -> blue -> teal.
    float3 deep = float3(0.03, 0.06, 0.12);
    float3 blue = float3(0.09, 0.20, 0.34);
    float3 teal = float3(0.06, 0.24, 0.28);
    float3 col = mix(deep, blue, smoothstep(0.30, 0.80, f));
    col = mix(col, teal, smoothstep(0.60, 0.98, f) * 0.6);

    // A soft, slow-moving highlight ridge for a bit more life.
    float ridge = smoothstep(0.035, 0.0, abs(f - 0.78));
    col += float3(0.05, 0.11, 0.15) * ridge;

    // Gentle vignette so the edges settle.
    float2 c = uv - 0.5;
    col *= 1.0 - dot(c, c) * 0.45;

    return half4(col, 1.0);
}
